<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Papelería - Catálogo de Productos</title>
    <link rel="stylesheet" href="catalog-styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <div class="app-container">
        <aside class="sidebar">
            <div class="sidebar-header">
                <img src="papeleria.png" alt="Logo Papelería Trejo" class="sidebar-logo-img">
        <h2>Papelería Trejo</h2>
    </div>
                
       
            <nav class="sidebar-menu">
                <a href="index.html" class="menu-item"><i class="fa-solid fa-house"></i> Inicio</a>
                <a href="catalog.html" class="menu-item active"><i class="fa-solid fa-store"></i> Catálogo</a>
                <a href="cart.html" class="menu-item"><i class="fa-solid fa-shopping-cart"></i> Carrito</a>
                <a href="profile.html" class="menu-item"><i class="fa-solid fa-user"></i> Mi Perfil</a>
            </nav>

            <div class="sidebar-footer">
                
            </div>
        </aside>

        <main class="main-content">
            <header class="content-header">
                <div class="search-bar-container">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="text" id="search-input" placeholder="Buscar productos de papelería...">
                </div>
            </header>

            <section class="favorites-section">
                <div class="section-title">
                    <i class="fa-solid fa-heart heart-title-icon"></i>
                    <h3>Mis Favoritos</h3>
                </div>
                <div class="favorites-grid" id="favorites-container">
                    <p class="empty-message">Aún no tienes productos favoritos marcados.</p>
                </div>
            </section>

            <hr class="section-divider">

            <section class="catalog-section">
                <div class="section-title">
                    <i class="fa-solid fa-boxes-stacked"></i>
                    <h3>Todos los Productos</h3>
                </div>
                <div class="products-grid" id="products-container">
                    </div>
            </section>
        </main>
    </div>

    <script src="catalog.js"></script>
</body>
</html>
